soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel",
    ],
}

cc_binary {
    name: "android.hardware.biometrics.fingerprint@2.1-service.ginkgo",
    relative_install_path: "hw",
    defaults: ["hidl_defaults"],
    init_rc: ["android.hardware.biometrics.fingerprint@2.1-service.ginkgo.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint@2.1-service.ginkgo.xml"],
    srcs: ["service.cpp", "BiometricsFingerprint.cpp"],
    shared_libs: [
        "android.hardware.power-V4-ndk",
        "libbase",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "android.hardware.biometrics.fingerprint@2.1",
    ],
    proprietary: true,
}
